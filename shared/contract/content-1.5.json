{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g3.dev/schema/content-1.5.json",
  "title": "G3 Content Schema 1.5",
  "description": "Structural contract for Content Defs and Manifest. Semantics (required/references/uniqueness) are enforced by the content validator; see docs/contracts/content-tooling.md.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
